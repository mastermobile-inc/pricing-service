# Customer account settlements: disabled for clients; shadow sync can be staged separately.
# CUSTOMER_SETTLEMENTS_ENABLED=false
# CUSTOMER_SETTLEMENTS_SHADOW_ENABLED=false
# CUSTOMER_SETTLEMENTS_ORGANIZATION_REF=0x00000000000000000000000000000000
# CUSTOMER_SETTLEMENTS_ORGANIZATION_GUID=00000000-0000-0000-0000-000000000000
# Confirm the environment-specific organization ref before enabling the live extractor.
# The register dimensions below were confirmed against Ekama on 2026-07-30.
# CUSTOMER_SETTLEMENTS_OPENING_ORGANIZATION_FIELD=_Fld7005RRef
# CUSTOMER_SETTLEMENTS_MOVEMENT_ORGANIZATION_FIELD=_Fld7005RRef
# CUSTOMER_SETTLEMENTS_COUNTERPARTY_INN_FIELD=_Fld611
# CUSTOMER_SETTLEMENTS_SOURCE_MODE=onec_canonical_mutual_statement_7002
# Manual confirmed mapping is the default; crm_readonly additionally requires a dedicated webhook.
# CUSTOMER_SETTLEMENTS_MAPPING_MODE=manual_confirmed
# Set true only after the SQL result is reconciled with the agreed UT 10.3 report.
# CUSTOMER_SETTLEMENTS_SOURCE_VALIDATED=false
# CUSTOMER_SETTLEMENTS_QUERY_TIMEOUT_SECONDS=30
# CUSTOMER_SETTLEMENTS_STALE_AFTER_SECONDS=7200
# CUSTOMER_SETTLEMENTS_HIDE_AFTER_SECONDS=21600
# CUSTOMER_SETTLEMENTS_MAPPING_STALE_AFTER_SECONDS=7200
# CUSTOMER_SETTLEMENTS_SUCCESS_RETENTION_DAYS=30
# CUSTOMER_SETTLEMENTS_FAILED_RETENTION_DAYS=7
# CUSTOMER_SETTLEMENTS_JTI_RETENTION_HOURS=24
# CUSTOMER_SETTLEMENTS_ASSERTION_ISSUER=master-mobile.ru
# CUSTOMER_SETTLEMENTS_ASSERTION_AUDIENCE=pricing-service:customer-settlements
# CUSTOMER_SETTLEMENTS_ASSERTION_ACTIVE_KID=site-key-1
# CUSTOMER_SETTLEMENTS_ASSERTION_ACTIVE_SECRET=replace-with-local-secret
# CUSTOMER_SETTLEMENTS_ASSERTION_PREVIOUS_KID=
# CUSTOMER_SETTLEMENTS_ASSERTION_PREVIOUS_SECRET=
# CUSTOMER_SETTLEMENTS_ASSERTION_TTL_SECONDS=60
# CUSTOMER_SETTLEMENTS_ASSERTION_CLOCK_SKEW_SECONDS=30
# CUSTOMER_SETTLEMENTS_ALLOWED_SOURCE_IPS=127.0.0.1
# CUSTOMER_SETTLEMENTS_CORRELATION_SALT=replace-with-local-log-salt
# CUSTOMER_SETTLEMENTS_CRM_WEBHOOK_URL=
# CUSTOMER_SETTLEMENTS_CRM_TIMEOUT_SECONDS=6
# Hard process timeout for cron artifacts; SQL remains capped at 30 seconds.
# CUSTOMER_SETTLEMENTS_JOB_TIMEOUT_SECONDS=90

# MANAGEMENT_RECEIVABLES_MAX_LAG_DAYS=1
# MANAGEMENT_STAFFING_MAX_LAG_DAYS=1
# MANAGEMENT_TASK_PAYLOADS_MAX_LAG_DAYS=1
# STAFFING_SYNC_STAFF_FILE=/opt/MM/pricing-service/data/staffing/staff.json
# STAFFING_SYNC_PLAN_FILE=/opt/MM/pricing-service/data/staffing/shift-plan.json
# STAFFING_SYNC_FACT_FILE=/opt/MM/pricing-service/data/staffing/shift-fact.json
# STAFFING_SYNC_LOOKBACK_DAYS=1
# STAFFING_SYNC_SNAPSHOT_DATES=2026-04-03,2026-04-04
# RETURN_SCHEME_ALERT_TELEGRAM_TOKEN=your-telegram-bot-token
# RETURN_SCHEME_ALERT_TELEGRAM_CHAT_ID=your-chat-id
# RETURN_SCHEME_DIRECT_TELEGRAM_ENABLED=false
# NOTE: default extractor is wired to the observed UT 10.3 MSSQL schema:
# _Document203 + _Document203_VT4966 for sales,
# _Document109 + _Document109_VT1698 for customer returns.
# If your 1C schema differs, override the SQL in `OneCReturnSchemeExtractor`.
# Server B / Openclaw delivery:
# RETURN_SCHEME_SOURCE_URL=https://server-a.example.com
