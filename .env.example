# Verified neutral contract with BP account 68/69 closing credit balances.
# EXECUTIVE_MANAGEMENT_BALANCE_BP_TAX_SNAPSHOT_PATH=/var/lib/mm-data-contracts/executive-dashboard/bp_tax_snapshot.json
# Monthly accrued tax expense for P&L; this is not the taxes-payable balance above.
# EXECUTIVE_DASHBOARD_BP_TAX_ACCRUAL_ROOT=/var/lib/mm-data-contracts/executive-dashboard/bp-tax-accruals
# EXECUTIVE_MANAGEMENT_BALANCE_PAYROLL_SNAPSHOT_PATH=/var/lib/mm-data-contracts/executive-dashboard/employee_payroll_balance_snapshot.json
# EXECUTIVE_MANAGEMENT_BALANCE_TOLERANCE_RUB=1
# EXECUTIVE_DASHBOARD_SOURCE_MAX_LAG_DAYS=1
