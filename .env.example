# Telegram bot (polling/webhook)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# TELEGRAM_WEBHOOK_URL=https://your-domain/telegram/webhook

# Logistics Telegram bot
# LOGISTICS_INTERNAL_API_TOKEN=your-logistics-internal-api-token
# Dedicated token for the durable management orchestration API. No fallback token is used.
# ORCHESTRATION_INTERNAL_API_TOKEN=your-orchestration-internal-api-token
# SMS journal: use three independent random values. Encryption key must be
# URL-safe base64 of exactly 32 random bytes; keep all values outside source control.
# SMS_JOURNAL_INTERNAL_API_TOKEN=generate-a-long-random-secret
# SMS_JOURNAL_ENCRYPTION_KEY=generate-a-url-safe-base64-32-byte-key
# SMS_JOURNAL_PHONE_HASH_KEY=generate-an-independent-long-random-secret
# SMS_JOURNAL_EXPORT_ALLOWED_ACTORS=bitrix-user-id-or-internal-actor
# LOGISTICS_BOT_TOKEN=your-logistics-telegram-bot-token
# LOGISTICS_BOT_POLL_TIMEOUT_SECONDS=30
# LOGISTICS_BOT_WEBHOOK_SECRET=some-long-random-secret
# LOGISTICS_BOT_WEBHOOK_URL=https://your-domain/api/logistics/bot/webhook
# LOGISTICS_WEB_SESSION_SECRET=replace-with-long-random-cookie-signing-secret
# LOGISTICS_WEB_SESSION_TTL_SECONDS=28800
# LOGISTICS_TRANSFER_ASSISTANT_PICKUP_HOLD_DAYS=7
