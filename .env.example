# Application
APP_PORT=18080
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pricing
POSTGRES_HOST=postgres
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:55432/pricing
# Optional pool overrides. Omit them to preserve SQLAlchemy defaults.
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_TIMEOUT_SECONDS=30
# DATABASE_POOL_RECYCLE_SECONDS=1800

# UT 10.3 file exchange (legacy forecast + nomenclature property updates)
# Observed Windows test contour:
UT103_EXCHANGE_ROOT=E:\MMExchange\UT103
# If pricing-service runs on Linux, mount/share the same folder and override this
# with the Linux path, e.g. UT103_EXCHANGE_ROOT=/mnt/ut103_exchange/UT103.
# If there is no mounted Windows share, use the local pricing-service outbox and
# let the Windows scheduler pull files from it:
# UT103_EXCHANGE_ROOT=/opt/MM/pricing-service/.local/ut103_exchange/UT103
# Do not use the Windows E:\... path from a Linux process unless that drive is
# exposed through a real mount path.

# Redis÷
REDIS_HOST=redis
REDIS_PORT=16379
REDIS_URL=redis://redis:16379/0

# CORS for UI (comma-separated origins, leave empty to disable)
# CORS_ALLOW_ORIGINS=http://localhost:5173
# CORS_ALLOW_CREDENTIALS=false
# CORS_ALLOW_METHODS=*
# CORS_ALLOW_HEADERS=*

# API Basic auth for matching endpoints
# API_BASIC_USER=admin
# API_BASIC_PASSWORD=changeme

# Dedicated service token for mm-compensation weekly KPI ingestion.
# WEEKLY_KPI_INGEST_INTERNAL_API_TOKEN=generate-a-long-random-secret

# Bitrix24 local app for competitor matching UI
# MATCHING_BITRIX_ENABLED=false
# MATCHING_BITRIX_ALLOWED_DOMAINS=crm.master-mobile.ru
# MATCHING_BITRIX_ALLOWED_MEMBER_IDS=your-bitrix-member-id
# Empty user list allows any user from the allowed Bitrix portal.
# MATCHING_BITRIX_ALLOWED_USER_IDS=42,1001
# MATCHING_BITRIX_SESSION_SECRET=generate-a-long-random-secret
# MATCHING_BITRIX_SESSION_TTL_SECONDS=3600
# MATCHING_BITRIX_REST_TIMEOUT_SECONDS=6

