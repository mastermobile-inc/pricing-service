# Customer price-type embedded Bitrix workplace (Phase 2, read-only)
# CUSTOMER_PRICE_TYPE_BITRIX_ENABLED=false
# CUSTOMER_PRICE_TYPE_BITRIX_ALLOWED_DOMAINS=crm.master-mobile.ru
# CUSTOMER_PRICE_TYPE_BITRIX_ALLOWED_MEMBER_IDS=your-bitrix-member-id
# FULL_ACCESS_USER_IDS is a break-glass admin override (rollout/IT); primary access is by org position.
# CUSTOMER_PRICE_TYPE_BITRIX_FULL_ACCESS_USER_IDS=42,1001
# v1 access is driven by Bitrix ORG POSITION (department membership / UF_HEAD), NOT by user lists,
# so it follows Bitrix staffing automatically. Roles (keyed by Bitrix department id):
#   network_head (full+money), finance/master_data/quality (department members),
#   department_head is resolved from live UF_HEAD and the existing receivables/staff
#   Bitrix department -> 1C refs mapping; do not duplicate that mapping here.
# CUSTOMER_PRICE_TYPE_ACCESS_RULES_JSON={"roles":[{"role":"executive","headed_department_ids":["100"]},{"role":"network_head","headed_department_ids":["200"]},{"role":"finance","department_ids":["12"]},{"role":"master_data","department_ids":["15"]},{"role":"quality","department_ids":["16"]}]}
# CUSTOMER_PRICE_TYPE_BITRIX_SESSION_SECRET=generate-a-separate-long-random-secret
# CUSTOMER_PRICE_TYPE_BITRIX_SESSION_TTL_SECONDS=3600
# CUSTOMER_PRICE_TYPE_BITRIX_REST_TIMEOUT_SECONDS=6

# Bitrix24 local app for VED procurement label generation
# PROCUREMENT_LABELS_BITRIX_ENABLED=false
