# Order payment control: site/CloudPayments -> read-only 1C order state
# ORDER_PAYMENT_CONTROL_INTERNAL_API_TOKEN=dedicated-payment-guard-token
# Непроведённый заказ по умолчанию оплату не блокирует: интернет-заказ попадает
# в 1С непроведённым и проводится позже.
# ORDER_PAYMENT_CONTROL_REQUIRE_POSTED=false
# ORDER_PAYMENT_CONTROL_CLOSURE_BLOCKS_PAYMENT=true
# Причины закрытия, которые НЕ считаются отменой заказа для клиента.
# ORDER_PAYMENT_CONTROL_CLOSURE_ALLOWED_REASONS=Исполнение заказа,Частичное исполнение заказа

# Internet order fulfillment: Bitrix chats -> backend state -> dry-run CRM recommendations
# ORDER_FULFILLMENT_INTERNAL_API_TOKEN=shared-service-token
# ORDER_PAYMENT_CONTROL_INTERNAL_API_TOKEN=dedicated-site-payment-token
# ORDER_FULFILLMENT_BITRIX_WEBHOOK_URL=https://bitrix.example/rest/1/token
# ORDER_FULFILLMENT_ARTIFACT_DIR=.local/order-fulfillment-pilot
# ORDER_FULFILLMENT_SITE_CHAT_DIALOG_ID=chat733
# ORDER_FULFILLMENT_SPB_COURIER_CHAT_DIALOG_ID=chat727
# Fail-closed switch: keep false during the mandatory 2-3 day dry-run.
# ORDER_FULFILLMENT_CHAT_AUTO_APPLY_ENABLED=false
# Only these Bitrix author IDs may produce auto-applied events in each chat.
# Empty allowlists keep every chat event in manual review.
# ORDER_FULFILLMENT_SITE_CHAT_APPLY_AUTHOR_IDS=101,102
# ORDER_FULFILLMENT_COURIER_CHAT_APPLY_AUTHOR_IDS=201,202
# ORDER_FULFILLMENT_OCR_ENABLED=true
# ORDER_FULFILLMENT_OCR_MODEL=gpt-4o-mini
# ORDER_FULFILLMENT_OCR_MIN_CONFIDENCE=0.75
# ORDER_FULFILLMENT_OCR_TIMEOUT_SECONDS=60
# ORDER_FULFILLMENT_OCR_MAX_IMAGE_BYTES=10485760
# Extra exact raw-delivery allowlist. The code also normalizes Самовывоз*, store names,
# Курьер/Доставка курьером/Dostavista/Такси, СДЭК and Почта России variants.
# ORDER_FULFILLMENT_KNOWN_RAW_DELIVERIES=Самовывоз,СДЭК (Самовывоз),Доставка курьером,Почта России (Доставка в отделение)
# ORDER_FULFILLMENT_SYNC_REVIEW_LIMIT=100
# ORDER_FULFILLMENT_NOTIFY_ENABLED=false
# ORDER_FULFILLMENT_NOTIFY_BUSINESS_USER_IDS=101,102,103,104
# ORDER_FULFILLMENT_NOTIFY_TECH_USER_IDS=201,104
# ORDER_FULFILLMENT_NOTIFY_METHOD=im.notify.system.add
# Group chat for MASTER-MOBILE.RU order reports. Defaults to ORDER_FULFILLMENT_SITE_CHAT_DIALOG_ID.
# Set "-" to disable chat publishing while keeping personal notifications.
# ORDER_FULFILLMENT_NOTIFY_SITE_DIALOG_ID=chat733
# ORDER_FULFILLMENT_NOTIFY_SITE_DIALOG_METHOD=im.message.add
# ORDER_FULFILLMENT_NOTIFY_STATE_PATH=.local/order-fulfillment-pilot/order-fulfillment-notify-state.json

