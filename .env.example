# YANDEX_METRIKA_TOKEN=your-yandex-metrika-oauth-token
# YANDEX_METRIKA_COUNTER_ID=49993429
# YANDEX_METRIKA_TIMEOUT_SECONDS=20
# EXECUTIVE_DASHBOARD_BITRIX_ENABLED=false
# EXECUTIVE_DASHBOARD_BITRIX_ALLOWED_DOMAINS=crm.master-mobile.ru
# EXECUTIVE_DASHBOARD_BITRIX_ALLOWED_MEMBER_IDS=your-bitrix-member-id
