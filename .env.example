# Bitrix24 local app for executive management dashboard
# EXECUTIVE_DASHBOARD_FINANCE_SNAPSHOT_PATH=/var/lib/mm-data-contracts/executive-dashboard/finance_snapshot.json
# EXECUTIVE_DASHBOARD_SALES_PLAN_SNAPSHOT_PATH=/var/lib/mm-data-contracts/executive-dashboard/sales_plan_monthly_snapshot.json
# EXECUTIVE_DASHBOARD_CASHFLOW_PERIOD_CACHE_PATH=/var/lib/mm-data-contracts/executive-dashboard/cashflow_period_cache.json
# EXECUTIVE_DASHBOARD_WAREHOUSE_SNAPSHOT_PATH=/var/lib/mm-data-contracts/executive-dashboard/warehouse_snapshot.json
