SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/sbin:/bin:/usr/sbin:/usr/bin
# Install only after addressed dry-run and enabling LOGISTICS_TRANSFER_SYNC_ENABLED.
